# Kopyalayın: cp .env.example .env   (gizli değerleri asla Git'e göndermeyin)
# Boş bırakılırsa SQLite kullanılır (apps/api/data/academy.db veya Docker'da /data/academy.db)
# DATABASE_URL=postgresql+psycopg://kullanici:parola@host/veritabani?sslmode=require
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Yönetici yedek uç noktaları için uzun, rastgele bir değer (python -c "import secrets;print(secrets.token_urlsafe(32))")
ADMIN_TOKEN=
# Hesabınızı oluşturduktan sonra yeni kayıtları kapatmak için false yapın
ALLOW_REGISTRATION=true
# Web uygulaması başka bir adresten (ör. GitHub Pages) API'ye bağlanacaksa o adresi ekleyin
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TOKEN_TTL_DAYS=90
